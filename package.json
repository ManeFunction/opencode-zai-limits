{
  "name": "opencode-zai-limits",
  "version": "1.0.1",
  "type": "module",
  "description": "Credit meter and usage reports for the Z.ai GLM Coding Plan in OpenCode v2 — a footer status line and a /zai-limits command, both free of credits and tokens, with zero dependencies",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./tui": "./dist/tui.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc && node scripts/build-tui.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tui.json",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run check",
    "check": "npm run build && npm run typecheck && node scripts/check-tui.mjs dist/tui.js"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "zai",
    "z.ai",
    "zhipu",
    "glm",
    "quota",
    "credits",
    "usage",
    "coding-plan",
    "ai",
    "llm"
  ],
  "author": "Ilia Petrov-Komotskii <ManeFunction>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ManeFunction/opencode-zai-limits.git"
  },
  "homepage": "https://github.com/ManeFunction/opencode-zai-limits#readme",
  "bugs": {
    "url": "https://github.com/ManeFunction/opencode-zai-limits/issues"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@babel/preset-typescript": "^7.29.7",
    "@types/node": "^20.0.0",
    "babel-preset-solid": "1.9.19",
    "typescript": "^5.9.0"
  }
}
