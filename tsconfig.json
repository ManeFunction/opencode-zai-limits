{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "resolveJsonModule": true,
    "noEmitOnError": true
  },
  // The server part only. src/tui.tsx is not compiled here: it uses Solid
  // JSX for OpenCode's own OpenTUI runtime and is compiled to dist/tui.js by
  // scripts/build-tui.mjs (npm run build). It is type-checked separately by
  // tsconfig.tui.json (`npm run typecheck`), against the declarations emitted
  // here.
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
